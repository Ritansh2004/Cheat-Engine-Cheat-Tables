          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : Kingdom.exe
  Version: 
  Date   : 2026-11-24
  Author : DANGER DASH

  This script does blah blah blah
}

define(address,Kingdom:AddArcher)
define(bytes,55 8B EC 83 EC 08)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,Kingdom:AddArcher)

label(code)
label(return)

newmem:
mov [kingdom_ptr],eax

code:
  push ebp
  mov ebp,esp
  sub esp,08
  jmp return

kingdom_ptr:
dd 0

address:
  jmp newmem
  nop
return:
registersymbol(kingdom_ptr)

[DISABLE]

address:
  db bytes
  // push ebp
  // mov ebp,esp
  // sub esp,08

dealloc(newmem)
unregistersymbol(kingdom_ptr)

