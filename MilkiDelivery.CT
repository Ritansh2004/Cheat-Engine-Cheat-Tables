1F2885A8145: 00 00                          - add [rax],al
1F2885A8147: 00 00                          - add [rax],al
1F2885A8149: 00 00                          - add [rax],al
1F2885A814B: 00 00                          - add [rax],al
1F2885A814D: 00 00                          - add [rax],al
1F2885A814F: 00                             - db 00 
// ---------- INJECTING HERE ----------
DebugManager:Update: 55                             - push rbp
// ---------- DONE INJECTING  ----------
DebugManager:Update+1: 48 8B EC                       - mov rbp,rsp
DebugManager:Update+4: 48 83 EC 30                    - sub rsp,30
DebugManager:Update+8: 48 89 75 F8                    - mov [rbp-08],rsi
DebugManager:Update+c: 48 8B F1                       - mov rsi,rcx
DebugManager:Update+f: 0F B6 46 38                    - movzx eax,byte ptr [rsi+38]
DebugManager:Update+13: 85 C0                          - test eax,eax
DebugManager:Update+15: 0F 84 68 00 00 00              - je DebugManager:Update+83
DebugManager:Update+1b: 48 8B CE                       - mov rcx,rsi
DebugManager:Update+1e: 49 BB 53 82 5A 88 F2 01 00 00  - mov r11,000001F2885A8253
DebugManager:Update+28: 41 FF D3                       - call r11
}
</AssemblerScript>
