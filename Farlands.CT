  Author : DANGER DASH

  This script does blah blah blah
}

define(address,Farlands.Dev.DebugController:Update)
define(bytes,55 48 8B EC 48 83 EC 30)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,Farlands.Dev.DebugController:Update)

label(code)
label(return)

newmem:
mov [debugcontroller_ptr],rcx

code:
  push rbp
  mov rbp,rsp
  sub rsp,30
  jmp return

debugcontroller_ptr:
dq 0

address:
  jmp newmem
  nop 3
return:
registersymbol(debugcontroller_ptr)

[DISABLE]

address:
  db bytes
  // push rbp
  // mov rbp,rsp
  // sub rsp,30

dealloc(newmem)
unregistersymbol(debugcontroller_ptr)

