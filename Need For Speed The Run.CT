            <CheatEntry>
              <ID>620</ID>
              <Description>"Manual Control Enable"</Description>
              <LastState/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$Lua}
local getMemRecByDesc = getAddressList().getMemoryRecordByDescription

MR_MyX = getMemRecByDesc("My X")
MR_MyY = getMemRecByDesc("My Y")
MR_MyZ = getMemRecByDesc("My Z")
MR_Rotate_X = getMemRecByDesc("My Rotate X")
MR_Rotate_Y = getMemRecByDesc("My Rotate Y")
MR_Focus = getMemRecByDesc("My Focus")

function checkKeys(timer)
   if (isKeyPressed(VK_F)) then
      MR_MyX.value = MR_MyX.value + 5
   end
   if (isKeyPressed(VK_G)) then
      MR_MyY.value = MR_MyY.value + 5
   end
   if (isKeyPressed(VK_H)) then
      MR_MyZ.value = MR_MyZ.value + 5
   end
   if (isKeyPressed(VK_J)) then
      MR_MyX.value = MR_MyX.value - 5
   end
   if (isKeyPressed(VK_K)) then
      MR_MyY.value = MR_MyY.value - 5
   end
   if (isKeyPressed(VK_L)) then
      MR_MyZ.value = MR_MyZ.value - 5
   end
   if (isKeyPressed(VK_N)) then
      MR_Rotate_X.value = MR_Rotate_X.value + .2
   end
   if (isKeyPressed(VK_M)) then
      MR_Rotate_X.value = MR_Rotate_X.value - .2
   end
   if (isKeyPressed(VK_B)) then
      MR_Rotate_Y.value = MR_Rotate_Y.value + .2
   end
   if (isKeyPressed(VK_V)) then
      MR_Rotate_Y.value = MR_Rotate_Y.value - .2
   end
   if (isKeyPressed(VK_P)) then
      MR_Focus.value = MR_Focus.value + .5
   end
   if (isKeyPressed(VK_O)) then
      MR_Focus.value = MR_Focus.value - .5
   end
end
t=createTimer(nil)
timer_setInterval(t, 1)
timer_onTimer(t, checkKeys)
timer_setEnabled(t, true)

[DISABLE]

{$Lua}
t.destroy();
t=nil
</AssemblerScript>
