<?xml version="1.0" encoding="utf-8"?>
<CheatTable ShowScriptErrors="1" CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry NoScriptTag="1">
      <ID>168</ID>
      <Description>"Initialize Mono"</Description>
      <Options moHideChildren="1"/>
      <LastState/>
      <Color>FF8080</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

local processName = "How to Fish.exe"
local pid = getProcessIDFromProcessName(processName)

if (pid == 0 or pid == nil) then
    -- 1. Notify the user
    showMessage("Start Game Process First..!!!")
    -- 2. Force the script to "crash" out of the Enable phase
    error("Process not found")
else
    -- Process found, proceed
    OpenProcess(processName)
    mono_initialize()
    LaunchMonoDataCollector()
    beep()                                               --For Sound
    showMessage("Made By DANGER DASH...!!!")             --Pop Up Message
end
{$asm}

[DISABLE]
{$lua}
if process then
    showMessage('Table Disabled!')
end
{$asm}

</AssemblerScript>
      <CheatEntries>
        <CheatEntry NoScriptTag="1">
          <ID>0</ID>
          <Description>"Player"</Description>
          <Options moHideChildren="1" moDefaultCollapsed="1" moAllowManualCollapseAndExpand="1"/>
          <LastState/>
          <Color>80FFFF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : How to Fish.exe
  Version: 
  Date   : 2026-08-22
  Author : DANGER DASH

  This script does blah blah blah
}

define(address,Player:TickUpdate)
define(bytes,55 48 8B EC 48 83 EC 30)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,Player:TickUpdate)

label(code)
label(return)

newmem:
mov [player_ptr],rcx

code:
  push rbp
  mov rbp,rsp
  sub rsp,30
  jmp return

player_ptr:
dq 0

address:
  jmp newmem
  nop 3
return:
registersymbol(player_ptr)

[DISABLE]

address:
  db bytes
  // push rbp
  // mov rbp,rsp
  // sub rsp,30

dealloc(newmem)
unregistersymbol(player_ptr)

{
// ORIGINAL CODE - INJECTION POINT: Player:TickUpdate

2C9E90BF79D: D3 08                          - ror [rax],cl
2C9E90BF79F: 78 EF                          - js 2C9E90BF790
2C9E90BF7A1: 46 27                          - daa 
2C9E90BF7A3: C9                             - leave 
2C9E90BF7A4: 02 00                          - add al,[rax]
2C9E90BF7A6: 00 00                          - add [rax],al
2C9E90BF7A8: 00 00                          - add [rax],al
2C9E90BF7AA: 00 00                          - add [rax],al
2C9E90BF7AC: 00 00                          - add [rax],al
2C9E90BF7AE: 00 00                          - add [rax],al
// ---------- INJECTING HERE ----------
Player:TickUpdate: 55                             - push rbp
// ---------- DONE INJECTING  ----------
Player:TickUpdate+1: 48 8B EC                       - mov rbp,rsp
Player:TickUpdate+4: 48 83 EC 30                    - sub rsp,30
Player:TickUpdate+8: 48 89 75 F8                    - mov [rbp-08],rsi
Player:TickUpdate+c: 48 8B F1                       - mov rsi,rcx
Player:TickUpdate+f: 48 8D AD 00 00 00 00           - lea rbp,[rbp+00000000]
Player:TickUpdate+16: 49 BB 00 00 6F F3 C9 02 00 00  - mov r11,Player:SendPosRot
Player:TickUpdate+20: 41 FF D3                       - call r11
Player:TickUpdate+23: 48 8B CE                       - mov rcx,rsi
Player:TickUpdate+26: 49 BB 60 0C 6F F3 C9 02 00 00  - mov r11,Player:CheckIsInside
Player:TickUpdate+30: 41 FF D3                       - call r11
}
