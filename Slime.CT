  <CheatEntries>
    <CheatEntry>
      <ID>356715</ID>
      <Description>"&lt;=== Auto attach to process "</Description>
      <Options moDeactivateChildrenAsWell="1"/>
      <LastState/>
      <Color>0000FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">[ENABLE]
{$lua}
if syntaxcheck then return end
  if(getCEVersion() &lt; 7.5) then
    ShowMessage('Warning! CE version should be 7.5 or above')
  end

   local pcss = 'Slime.exe' -- name of game exe
 openProcess(pcss)
  if (readInteger(process) == readInteger(pcss)) and (readInteger(process) ~= nil) then
        -- mono_initialize()
monoSymbolList = nil
LaunchMonoDataCollector()
if monoSymbolList ~= nil then
  while not monoSymbolList.FullyLoaded do
    if inMainThread() then checkSynchronize(10) else Sleep(10) end
  end
end
else
ShowMessage('The process Slime.exe is NOT found!')
return "nop"
      end
{$asm}
