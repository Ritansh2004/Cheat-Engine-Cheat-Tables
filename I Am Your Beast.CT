define(address,DebugManager:Update)
define(bytes,55 48 8B EC 48 81 EC A0 00 00 00)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,DebugManager:Update)

label(code)
label(return)

newmem:
mov [debugmanager_ptr],rcx

code:
  push rbp
  mov rbp,rsp
  sub rsp,000000A0
  jmp return

debugmanager_ptr:
dq 0

address:
  jmp newmem
  nop 6
return:
registersymbol(debugmanager_ptr)

[DISABLE]

