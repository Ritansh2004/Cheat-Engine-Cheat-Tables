<?xml version="1.0" encoding="utf-8"?>
<CheatTable UsesMono="1" ShowScriptErrors="1" CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry NoScriptTag="1">
      <ID>428</ID>
      <Description>"Initialize Mono"</Description>
      <Options moHideChildren="1"/>
      <LastState Activated="1"/>
      <Color>FF8080</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

local processName = "Quasimorph.exe"
local pid = getProcessIDFromProcessName(processName)

if (pid == 0 or pid == nil) then
    -- 1. Notify the user
    showMessage("Start Game Process First..!!!")
    -- 2. Force the script to "crash" out of the Enable phase
    error("Process not found")
else
    -- Process found, proceed
    OpenProcess(processName)
    mono_initialize()
    LaunchMonoDataCollector()
    beep()                                               --For Sound
    showMessage("Made By DANGER DASH...!!!")             --Pop Up Message
end
{$asm}

[DISABLE]
{$lua}
if process then
    showMessage('Table Disabled!')
end
{$asm}

</AssemblerScript>
      <CheatEntries>
        <CheatEntry NoScriptTag="1">
          <ID>0</ID>
          <Description>"Player"</Description>
          <Options moHideChildren="1" moDefaultCollapsed="1" moAllowManualCollapseAndExpand="1"/>
          <LastState Activated="1"/>
          <Color>80FFFF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : Quasimorph.exe
  Version: 
  Date   : 2026-08-01
  Author : DANGER DASH

  This script does blah blah blah
}

define(address,MGSC.Player:OnMoved)
define(bytes,55 48 8B EC 48 81 EC 60 01 00 00)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,MGSC.Player:OnMoved)

label(code)
label(return)

newmem:
mov [player_ptr],rcx

code:
  push rbp
  mov rbp,rsp
  sub rsp,00000160
  jmp return

player_ptr:
dq 0

address:
  jmp newmem
  nop 6
return:
registersymbol(player_ptr)

[DISABLE]

address:
  db bytes
  // push rbp
  // mov rbp,rsp
  // sub rsp,00000160

dealloc(newmem)
unregistersymbol(player_ptr)

{
// ORIGINAL CODE - INJECTION POINT: MGSC.Player:OnMoved

251AFBB2E29: 00 00                          - add [rax],al
251AFBB2E2B: 00 00                          - add [rax],al
251AFBB2E2D: 00 00                          - add [rax],al
251AFBB2E2F: 00 01                          - add [rcx],al
251AFBB2E31: 04 02                          - add al,02
251AFBB2E33: 05 04 03 01 50                 - add eax,50010304
251AFBB2E38: 00 00                          - add [rax],al
251AFBB2E3A: 00 00                          - add [rax],al
251AFBB2E3C: 00 00                          - add [rax],al
251AFBB2E3E: 00 00                          - add [rax],al
// ---------- INJECTING HERE ----------
MGSC.Player:OnMoved: 55                             - push rbp
// ---------- DONE INJECTING  ----------
MGSC.Player:OnMoved+1: 48 8B EC                       - mov rbp,rsp
MGSC.Player:OnMoved+4: 48 81 EC 60 01 00 00           - sub rsp,00000160
MGSC.Player:OnMoved+b: 48 89 5D E0                    - mov [rbp-20],rbx
MGSC.Player:OnMoved+f: 48 89 75 E8                    - mov [rbp-18],rsi
MGSC.Player:OnMoved+13: 48 89 7D F0                    - mov [rbp-10],rdi
MGSC.Player:OnMoved+17: 4C 89 65 F8                    - mov [rbp-08],r12
MGSC.Player:OnMoved+1b: 48 8B F1                       - mov rsi,rcx
MGSC.Player:OnMoved+1e: C7 85 28 FF FF FF 00 00 00 00  - mov [rbp-000000D8],00000000
MGSC.Player:OnMoved+28: C7 85 2C FF FF FF 00 00 00 00  - mov [rbp-000000D4],00000000
MGSC.Player:OnMoved+32: C7 85 30 FF FF FF 00 00 00 00  - mov [rbp-000000D0],00000000
}
