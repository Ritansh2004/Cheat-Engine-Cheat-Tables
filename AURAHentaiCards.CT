<?xml version="1.0" encoding="utf-8"?>
<CheatTable ShowScriptErrors="1" CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry NoScriptTag="1">
      <ID>240</ID>
      <Description>"Initialize Mono"</Description>
      <Options moHideChildren="1"/>
      <LastState/>
      <Color>FF8080</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

local processName = "AURAHentaiCards.exe"
local pid = getProcessIDFromProcessName(processName)

if (pid == 0 or pid == nil) then
    -- 1. Notify the user
    showMessage("Start Game Process First..!!!")
    -- 2. Force the script to "crash" out of the Enable phase
    error("Process not found")
else
    -- Process found, proceed
    OpenProcess(processName)
    mono_initialize()
    LaunchMonoDataCollector()
    beep()                                               --For Sound
    showMessage("Made By DANGER DASH...!!!")             --Pop Up Message
end
{$asm}

[DISABLE]
{$lua}
if process then
    showMessage('Table Disabled!')
end
{$asm}

</AssemblerScript>
      <CheatEntries>
        <CheatEntry NoScriptTag="1">
          <ID>2</ID>
          <Description>"BattleController"</Description>
          <Options moHideChildren="1" moDefaultCollapsed="1" moAllowManualCollapseAndExpand="1"/>
          <LastState Activated="1"/>
          <Color>80FFFF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : AURAHentaiCards.exe
  Version: 
  Date   : 2026-11-05
  Author : DANGER DASH

  This script does blah blah blah
}

define(address,BattleController:SetPlayerRound)
define(bytes,55 48 8B EC 48 83 EC 40)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,BattleController:SetPlayerRound)

label(code)
label(return)

newmem:
mov [battlecontroller_ptr],rcx

code:
  push rbp
  mov rbp,rsp
  sub rsp,40
  jmp return

battlecontroller_ptr:
dq 0

address:
  jmp newmem
  nop 3
return:
registersymbol(battlecontroller_ptr)

[DISABLE]

address:
  db bytes
  // push rbp
  // mov rbp,rsp
  // sub rsp,40

dealloc(newmem)
unregistersymbol(battlecontroller_ptr)

{
// ORIGINAL CODE - INJECTION POINT: BattleController:SetPlayerRound

1B18AB5833D: 00 00                 - add [rax],al
1B18AB5833F: 00 00                 - add [rax],al
1B18AB58341: 00 00                 - add [rax],al
1B18AB58343: 00 00                 - add [rax],al
1B18AB58345: 00 00                 - add [rax],al
