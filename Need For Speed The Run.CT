        <CheatEntry>
          <ID>13</ID>
          <Description>"Fast Boot"</Description>
          <LastState/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

//Enable it before the loading square logo disappears when booting up the game

aobscan(fastboot,23 70 49 AF 00 00 00 00 00)
registersymbol(fastboot)

fastboot+08:
  db 01


[DISABLE]

fastboot+08:
  db 00

unregistersymbol(fastboot)

</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
