define(address,Global.Wallet.Currency:RemoveFromValue)
define(bytes,55 48 8B EC 48 83 EC 30)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,Global.Wallet.Currency:RemoveFromValue)

label(code)
label(return)

newmem:
mov [currency_ptr],rcx

code:
  push rbp
  mov rbp,rsp
  sub rsp,30
  jmp return

currency_ptr:
dq 0

address:
  jmp newmem
  nop 3
return:
registersymbol(currency_ptr)

[DISABLE]

address:
  db bytes
  // push rbp
  // mov rbp,rsp
  // sub rsp,30

dealloc(newmem)
unregistersymbol(currency_ptr)

