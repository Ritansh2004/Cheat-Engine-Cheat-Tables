<?xml version="1.0" encoding="utf-8"?>
<CheatTable ShowScriptErrors="1" CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry NoScriptTag="1">
      <ID>2</ID>
      <Description>"Initialize Mono"</Description>
      <Options moHideChildren="1"/>
      <LastState Activated="1"/>
      <Color>FF8080</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

local processName = "Gurei.exe"
local pid = getProcessIDFromProcessName(processName)

if (pid == 0 or pid == nil) then
    -- 1. Notify the user
    showMessage("Start Game Process First..!!!")
    -- 2. Force the script to "crash" out of the Enable phase
    error("Process not found")
else
    -- Process found, proceed
    OpenProcess(processName)
    mono_initialize()
    LaunchMonoDataCollector()
    beep()                                               --For Sound
    showMessage("Made By DANGER DASH...!!!")             --Pop Up Message
end
{$asm}

[DISABLE]
{$lua}
if process then
    showMessage('Table Disabled!')
end
{$asm}

</AssemblerScript>
      <CheatEntries>
        <CheatEntry NoScriptTag="1">
          <ID>0</ID>
          <Description>"Player"</Description>
          <Options moHideChildren="1" moDefaultCollapsed="1" moAllowManualCollapseAndExpand="1"/>
          <LastState Activated="1"/>
          <Color>80FFFF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : Gurei.exe
  Version: 
  Date   : 2026-07-25
  Author : DANGER DASH

  This script does blah blah blah
}

define(address,Player:Update)
define(bytes,55 48 8B EC 48 83 EC 40)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,Player:Update)

label(code)
label(return)

newmem:
mov [player_ptr],rcx

code:
  push rbp
  mov rbp,rsp
  sub rsp,40
  jmp return

player_ptr:
dq 0

address:
  jmp newmem
  nop 3
return:
registersymbol(player_ptr)

[DISABLE]

address:
  db bytes
  // push rbp
  // mov rbp,rsp
  // sub rsp,40

dealloc(newmem)
unregistersymbol(player_ptr)

{
// ORIGINAL CODE - INJECTION POINT: Player:Update

InputHandler:CheckSlamInputHoldTime+7b: 5D              - pop rbp
InputHandler:CheckSlamInputHoldTime+7c: C3              - ret 
1ED238559FD: 00 00           - add [rax],al
1ED238559FF: 00 01           - add [rcx],al
1ED23855A01: 04 02           - add al,02
1ED23855A03: 05 04 03 01 50  - add eax,50010304
1ED23855A08: 00 00           - add [rax],al
1ED23855A0A: 00 00           - add [rax],al
1ED23855A0C: 00 00           - add [rax],al
1ED23855A0E: 00 00           - add [rax],al
// ---------- INJECTING HERE ----------
Player:Update: 55              - push rbp
// ---------- DONE INJECTING  ----------
Player:Update+1: 48 8B EC        - mov rbp,rsp
Player:Update+4: 48 83 EC 40     - sub rsp,40
Player:Update+8: 48 89 75 F8     - mov [rbp-08],rsi
Player:Update+c: 48 8B F1        - mov rsi,rcx
Player:Update+f: 48 8B 46 20     - mov rax,[rsi+20]
Player:Update+13: 48 8B C8        - mov rcx,rax
Player:Update+16: 83 39 00        - cmp dword ptr [rcx],00
Player:Update+19: 48 8B 40 10     - mov rax,[rax+10]
Player:Update+1d: 48 8B C8        - mov rcx,rax
Player:Update+20: 48 8B 00        - mov rax,[rax]
}
