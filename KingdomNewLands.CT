Character:add_OnGrabbed+72: 68 96 06 00 00  - push 00000696
Character:add_OnGrabbed+77: E8 74 D9 89 FF  - call 04EE0F38
056435C4: 00 00           - add [eax],al
056435C6: 00 00           - add [eax],al
// ---------- INJECTING HERE ----------
Kingdom:AddArcher: 55              - push ebp
// ---------- DONE INJECTING  ----------
Kingdom:AddArcher+1: 8B EC           - mov ebp,esp
Kingdom:AddArcher+3: 83 EC 08        - sub esp,08
Kingdom:AddArcher+6: 8B 45 08        - mov eax,[ebp+08]
Kingdom:AddArcher+9: 8B 40 4C        - mov eax,[eax+4C]
Kingdom:AddArcher+c: 83 EC 08        - sub esp,08
Kingdom:AddArcher+f: FF 75 0C        - push [ebp+0C]
Kingdom:AddArcher+12: 50              - push eax
Kingdom:AddArcher+13: 8B 00           - mov eax,[eax]
Kingdom:AddArcher+15: BA 68 93 04 12  - mov edx,12049368
Kingdom:AddArcher+1a: 90              - nop
}
