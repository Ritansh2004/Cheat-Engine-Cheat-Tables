        <CheatEntry>
          <ID>356745</ID>
          <Description>"Battle player pointers + Game config"</Description>
          <Options moHideChildren="1" moDefaultCollapsed="1" moAllowManualCollapseAndExpand="1"/>
          <LastState/>
          <Color>80FFFF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript Async="1">{  Game Executable   : Slime.exe
   Author            : Tuuup!
   Executable Version: 2021.3.25.61228
   Script Date       : 2024-08-09
}
[ENABLE]
aobscanmodule(playerhp,GameAssembly.dll,66 0F 6E 8B 2C 03 00 00 0F 5B C0 0F)
registersymbol(playerhp playerhpbkp pbase)
alloc(newmem,128,playerhp)
label(return pbase)
label(playerhpbkp)
newmem:
 mov [pbase],rbx
  movd xmm1,[rbx+0000032C]
  jmp return
  
  align 10 cc
  
playerhpbkp:
readmem(playerhp,8)

align 10 cc
pbase:
dq 0
playerhp:
  jmp newmem
  nop 3
return:

[DISABLE]
playerhp:
 // db 66 0F 6E 8B 2C 03 00 00
readmem(playerhpbkp,8)
unregistersymbol(*)
dealloc(*)

