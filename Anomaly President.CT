  Author : DANGER DASH

  This script does blah blah blah
}

define(address,"GameAssembly.dll"+761950)
define(bytes,33 D2 E9 A9 DF FF FF)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,"GameAssembly.dll"+761950)

label(code)
label(return)

newmem:
mov [player_ptr],rcx

code:
  xor edx,edx
  jmp Player.Movement_GetAndSetInputValue
  jmp return

player_ptr:
dq 0

address:
  jmp newmem
  nop 2
return:
registersymbol(player_ptr)

[DISABLE]

address:
  db bytes
  // xor edx,edx
  // jmp Player.Movement_GetAndSetInputValue

dealloc(newmem)
unregistersymbol(player_ptr)

