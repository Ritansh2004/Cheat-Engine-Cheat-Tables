  Author : DANGER DASH

  This script does blah blah blah
}

define(address,PlayerProfile:UpdateUserName)
define(bytes,55 48 8B EC 48 83 EC 40)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,PlayerProfile:UpdateUserName)

label(code)
label(return)

newmem:
mov [playerprofile_ptr],rcx

code:
  push rbp
  mov rbp,rsp
  sub rsp,40
  jmp return

playerprofile_ptr:
dq 0

address:
  jmp newmem
  nop 3
return:
registersymbol(playerprofile_ptr)

[DISABLE]

address:
  db bytes
  // push rbp
  // mov rbp,rsp
  // sub rsp,40

dealloc(newmem)
unregistersymbol(playerprofile_ptr)

