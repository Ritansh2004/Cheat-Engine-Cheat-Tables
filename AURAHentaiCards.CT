1B18AB58349: 00 00                 - add [rax],al
1B18AB5834B: 00 00                 - add [rax],al
1B18AB5834D: 00 00                 - add [rax],al
1B18AB5834F: 00                    - db 00 
// ---------- INJECTING HERE ----------
BattleController:SetPlayerRound: 55                    - push rbp
// ---------- DONE INJECTING  ----------
BattleController:SetPlayerRound+1: 48 8B EC              - mov rbp,rsp
BattleController:SetPlayerRound+4: 48 83 EC 40           - sub rsp,40
BattleController:SetPlayerRound+8: 48 89 75 E8           - mov [rbp-18],rsi
BattleController:SetPlayerRound+c: 48 89 7D F0           - mov [rbp-10],rdi
BattleController:SetPlayerRound+10: 4C 89 7D F8           - mov [rbp-08],r15
BattleController:SetPlayerRound+14: 48 8B F1              - mov rsi,rcx
BattleController:SetPlayerRound+17: 48 8B 4E 28           - mov rcx,[rsi+28]
BattleController:SetPlayerRound+1b: 48 8B 86 B0 00 00 00  - mov rax,[rsi+000000B0]
BattleController:SetPlayerRound+22: 48 8B D0              - mov rdx,rax
BattleController:SetPlayerRound+25: 83 3A 00              - cmp dword ptr [rdx],00
}
