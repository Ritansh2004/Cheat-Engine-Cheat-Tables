alloc(newmem,$1000,ShapeWar.PlayerGold:TrySpend+6f)

label(code)
label(return)

newmem:
mov [golddata_ptr],rax

code:
  movsxd  rcx,dword ptr [rax+10]
  sub ecx,esi
  jmp return

golddata_ptr:
dq 0

address:
  jmp newmem
  nop
return:
registersymbol(golddata_ptr)

[DISABLE]

