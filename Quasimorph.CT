251AFBB2E3C: 00 00                          - add [rax],al
251AFBB2E3E: 00 00                          - add [rax],al
// ---------- INJECTING HERE ----------
MGSC.Player:OnMoved: 55                             - push rbp
// ---------- DONE INJECTING  ----------
MGSC.Player:OnMoved+1: 48 8B EC                       - mov rbp,rsp
MGSC.Player:OnMoved+4: 48 81 EC 60 01 00 00           - sub rsp,00000160
MGSC.Player:OnMoved+b: 48 89 5D E0                    - mov [rbp-20],rbx
MGSC.Player:OnMoved+f: 48 89 75 E8                    - mov [rbp-18],rsi
MGSC.Player:OnMoved+13: 48 89 7D F0                    - mov [rbp-10],rdi
MGSC.Player:OnMoved+17: 4C 89 65 F8                    - mov [rbp-08],r12
MGSC.Player:OnMoved+1b: 48 8B F1                       - mov rsi,rcx
MGSC.Player:OnMoved+1e: C7 85 28 FF FF FF 00 00 00 00  - mov [rbp-000000D8],00000000
MGSC.Player:OnMoved+28: C7 85 2C FF FF FF 00 00 00 00  - mov [rbp-000000D4],00000000
MGSC.Player:OnMoved+32: C7 85 30 FF FF FF 00 00 00 00  - mov [rbp-000000D0],00000000
