}

define(address,ArmyPlayerController:FixedUpdate)
define(bytes,55 48 8B EC 48 83 EC 40)

[ENABLE]

assert(address,bytes)
alloc(newmem,$1000,ArmyPlayerController:FixedUpdate)

label(code)
label(return)

newmem:
mov [armyplayercontroller_ptr],rcx

code:
  push rbp
  mov rbp,rsp
  sub rsp,40
  jmp return

armyplayercontroller_ptr:
dq 0

address:
  jmp newmem
  nop 3
return:
registersymbol(armyplayercontroller_ptr)

[DISABLE]

address:
  db bytes
  // push rbp
  // mov rbp,rsp
  // sub rsp,40

dealloc(newmem)
unregistersymbol(armyplayercontroller_ptr)

